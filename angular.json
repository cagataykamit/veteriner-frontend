{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "vetinity-web": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "changeDetection": "OnPush"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/vetinity-web",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "**/*",
                                "input": "src/assets/brand",
                                "output": "assets/brand"
                            },
                            {
                                "glob": "*.webp",
                                "input": "projects/site-engine/stock/photos",
                                "output": "_stock"
                            },
                            {
                                "glob": "zxing_reader.wasm",
                                "input": "node_modules/zxing-wasm/dist/reader",
                                "output": "vendor/zxing"
                            }
                        ],
                        "styles": [
                            "src/assets/styles.scss",
                            "src/assets/tailwind.css",
                            "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
                            "node_modules/@fortawesome/fontawesome-free/css/solid.min.css",
                            {
                                "input": "projects/site-engine/src/styles/site-fonts.css",
                                "bundleName": "site-fonts",
                                "inject": false
                            }
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "outputHashing": "all",
                            "serviceWorker": "ngsw-config.json"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.development.ts"
                                }
                            ]
                        },
                        "staging": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "outputHashing": "all",
                            "serviceWorker": "ngsw-config.json",
                            "assets": [
                                {
                                    "glob": "**/*",
                                    "input": "public",
                                    "ignore": ["robots.txt", "sitemap.xml"]
                                },
                                {
                                    "glob": "**/*",
                                    "input": "src/assets/brand",
                                    "output": "assets/brand"
                                },
                                {
                                    "glob": "*.webp",
                                    "input": "projects/site-engine/stock/photos",
                                    "output": "_stock"
                                },
                                {
                                    "glob": "zxing_reader.wasm",
                                    "input": "node_modules/zxing-wasm/dist/reader",
                                    "output": "vendor/zxing"
                                },
                                {
                                    "glob": "robots.txt",
                                    "input": "public-staging"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.staging.ts"
                                }
                            ]
                        },
                        "testing": {
                            "aot": false,
                            "optimization": false,
                            "extractLicenses": false,
                            "assets": [
                                "src/favicon.ico",
                                "src/assets",
                                {
                                    "glob": "*.webp",
                                    "input": "projects/site-engine/stock/photos",
                                    "output": "_stock"
                                }
                            ],
                            "styles": []
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "proxyConfig": "proxy.conf.json"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "vetinity-web:build:production"
                        },
                        "development": {
                            "buildTarget": "vetinity-web:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "tsconfig.spec.json",
                        "include": ["**/*.spec.ts", "../projects/site-engine/src/**/*.spec.ts"],
                        "buildTarget": ":build:testing",
                        "setupFiles": ["src/test-setup.ts"],
                        "runner": "vitest",
                        "browsers": ["ChromiumHeadless"],
                        "browserViewport": "800x600",
                        "runnerConfig": true
                    }
                }
            }
        },
        "portal": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/portal",
            "sourceRoot": "projects/portal/src",
            "prefix": "portal",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/portal",
                        "index": "projects/portal/src/index.html",
                        "browser": "projects/portal/src/main.ts",
                        "tsConfig": "projects/portal/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/portal/public"
                            }
                        ],
                        "styles": [
                            "projects/portal/src/styles.scss",
                            "projects/portal/src/tailwind.css",
                            "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
                            "node_modules/@fortawesome/fontawesome-free/css/solid.min.css"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "700kb",
                                    "maximumError": "1.5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "outputHashing": "all",
                            "serviceWorker": "projects/portal/ngsw-config.json"
                        },
                        "staging": {
                            "outputHashing": "all",
                            "serviceWorker": "projects/portal/ngsw-config.json",
                            "fileReplacements": [
                                {
                                    "replace": "projects/portal/src/environments/environment.ts",
                                    "with": "projects/portal/src/environments/environment.staging.ts"
                                }
                            ]
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "fileReplacements": [
                                {
                                    "replace": "projects/portal/src/environments/environment.ts",
                                    "with": "projects/portal/src/environments/environment.development.ts"
                                }
                            ]
                        },
                        "testing": {
                            "aot": false,
                            "optimization": false,
                            "extractLicenses": false,
                            "styles": []
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "port": 4300,
                        "proxyConfig": "projects/portal/proxy.conf.json"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "portal:build:production"
                        },
                        "development": {
                            "buildTarget": "portal:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/portal/tsconfig.spec.json",
                        "buildTarget": ":build:testing",
                        "runner": "vitest",
                        "browsers": ["ChromiumHeadless"],
                        "browserViewport": "800x600",
                        "runnerConfig": true
                    }
                }
            }
        },
        "site": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "css"
                }
            },
            "root": "projects/site",
            "sourceRoot": "projects/site/src",
            "prefix": "site",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/site",
                        "index": "projects/site/src/index.html",
                        "browser": "projects/site/src/main.ts",
                        "server": "projects/site/src/main.server.ts",
                        "outputMode": "server",
                        "ssr": {
                            "entry": "projects/site/src/server.ts"
                        },
                        "baseHref": "/k/",
                        "deployUrl": "/k/",
                        "tsConfig": "projects/site/tsconfig.app.json",
                        "assets": [
                            {
                                "glob": "*.webp",
                                "input": "projects/site-engine/stock/photos",
                                "output": "_stock"
                            }
                        ],
                        "styles": ["projects/site/src/styles.css"],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "700kb",
                                    "maximumError": "1.5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "testing": {
                            "aot": false,
                            "optimization": false,
                            "extractLicenses": false,
                            "server": false,
                            "outputMode": "static",
                            "ssr": false,
                            "styles": []
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "port": 4400,
                        "proxyConfig": "projects/site/proxy.conf.json"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "site:build:production"
                        },
                        "development": {
                            "buildTarget": "site:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/site/tsconfig.spec.json",
                        "buildTarget": ":build:testing",
                        "runner": "vitest",
                        "browsers": ["ChromiumHeadless"],
                        "browserViewport": "800x600",
                        "runnerConfig": true
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}
