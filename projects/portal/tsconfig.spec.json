{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../out-tsc/portal-spec",
        "rootDir": "./src",
        "types": [
            "vitest/globals"
        ],
        "paths": {
            "@portal/*": ["./src/*"]
        }
    },
    "include": [
      "src/**/*.spec.ts",
      "src/**/*.d.ts"
    ],
    "angularCompilerOptions": {
      "extendedDiagnostics": {
        "checks": {
          "nullishCoalescingNotNullable": "suppress",
          "optionalChainNotNullable": "suppress"
        }
      }
    }
}
