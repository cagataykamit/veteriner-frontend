/* Hasta sahibi portalı (ADR-031 K5): klinik paneliyle aynı derleyici kuralları, ayrı kaynak kökü.
   `paths` burada yeniden tanımlanır; panelin `@/*` takma adı portalda çözülmez (panel kodu portal paketine girmez). */
{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../out-tsc/portal",
        "rootDir": "./src",
        "types": [],
        "paths": {
            "@portal/*": ["./src/*"]
        }
    },
    "files": ["src/main.ts"],
    "include": [
      "src/**/*.d.ts"
    ],
    "angularCompilerOptions": {
      "extendedDiagnostics": {
        "checks": {
          "nullishCoalescingNotNullable": "suppress",
          "optionalChainNotNullable": "suppress"
        }
      }
    }
}
